{
  "manifest_version": 3,
  "name": "Overleaf Codex",
  "version": "1.7.0",
  "description": "Discuss or revise Overleaf selections and files with Codex and installed plugins.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://overleaf.com/*",
    "https://*.overleaf.com/*",
    "http://127.0.0.1:47831/*",
    "http://localhost:47831/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://overleaf.com/*",
        "https://*.overleaf.com/*"
      ],
      "js": [
        "vendor/markdown-it/markdown-it.min.js",
        "vendor/katex/katex.min.js",
        "message-renderer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*"
      ],
      "matches": [
        "https://overleaf.com/*",
        "https://*.overleaf.com/*"
      ]
    }
  ],
  "options_page": "options.html",
  "commands": {
    "open-codex-dialog": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Overleaf Codex"
    },
    "add-selection-reference": {
      "suggested_key": {
        "default": "Ctrl+Shift+I",
        "mac": "Command+Shift+I"
      },
      "description": "Add the current Overleaf selection as a Codex reference"
    }
  },
  "action": {
    "default_title": "Overleaf Codex",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
